{
  "manifest_version": 3,
  "name": "DevFrame - SAPUI5 DevTools Cockpit",
  "version": "1.0.0",
  "description": "Modern developer cockpit for SAPUI5 application debugging, analysis, OData context inspection, and AI diagnostics.",
  "devtools_page": "src/devtools/devtools.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/bridge/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/bridge/content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting"
  ]
}
