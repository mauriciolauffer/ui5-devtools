{
  "name": "ui5-devtools",
  "version": "1.0.0",
  "description": "DevFrame DevTools for SAPUI5 - Advanced developer cockpit for SAPUI5 applications",
  "keywords": [
    "chrome-extension",
    "devframe",
    "devtools",
    "fiori",
    "fiori-elements",
    "openui5",
    "sapui5"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mauriciolauffer/ui5-devtools.git"
  },
  "bin": {
    "devframe-ui5": "./bin/devframe-ui5.js"
  },
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "build": "esbuild src/bridge/content.js --bundle --outfile=dist/content.js --format=iife",
