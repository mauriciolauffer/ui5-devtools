    "lint": "oxlint",
    "fmt": "oxfmt"
  },
  "devDependencies": {
    "devframe": "^1.2.3",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
